{
  "type": "object",
  "required": [
    "schema",
    "episode_id",
    "status",
    "one_product",
    "one_test",
    "mechanic",
    "consent",
    "novel_candidates"
  ],
  "properties": {
    "schema": {
      "const": "systm/idea@1"
    },
    "episode_id": {
      "type": "string",
      "pattern": "^EP\\d{3,4}$"
    },
    "status": {
      "enum": [
        "draft",
        "ready",
        "needs_revision",
        "blocked"
      ]
    },
    "provenance": {
      "type": "object"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "one_product": {
      "type": "string",
      "minLength": 1
    },
    "one_test": {
      "type": "string",
      "minLength": 1
    },
    "business_pain": {
      "type": "string"
    },
    "mechanic": {
      "enum": [
        "timer",
        "audience_request",
        "blind_test",
        "failed_attempt",
        "manual_vs_ai",
        "duplicate_lead"
      ]
    },
    "consent": {
      "type": "object",
      "required": [
        "required",
        "state"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "state": {
          "enum": [
            "not_needed",
            "pending",
            "obtained"
          ]
        },
        "note": {
          "type": "string"
        }
      }
    },
    "novel_candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "axis",
          "key",
          "why"
        ],
        "properties": {
          "axis": {
            "enum": [
              "mechanism",
              "edit_camera",
              "text",
              "sound",
              "hook"
            ]
          },
          "key": {
            "type": "string",
            "minLength": 1
          },
          "why": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "rejected_ideas": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "idea",
          "reason"
        ],
        "properties": {
          "idea": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
